# Jumpstart — Caddy alternative to deploy/nginx/jumpstart.conf.
#
# Pick one. Caddy is the lower-effort option: automatic Let's Encrypt
# (issuance + renewal), HTTP/2 and HTTP/3 on by default, and Zstd/gzip
# negotiation with no module compilation. The Nginx config exists because
# it is what most VPS tutorials and existing ops runbooks assume — if the
# team has no Nginx muscle memory to preserve, this file is less to get
# wrong.
#
# Caveat: Caddy has no Brotli encoder built in (the maintainers removed
# it; `zstd gzip` is the default). Precompressed .br/.gz files produced at
# build time are still served via file_server's precompressed support,
# which is what we rely on below.
#
#   sudo cp deploy/caddy/Caddyfile /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

jumpstartedu.com, www.jumpstartedu.com {
	root * /var/www/jumpstart/dist

	encode zstd gzip

	# API first — more specific matchers must precede the SPA fallback.
	handle /api/* {
		reverse_proxy 127.0.0.1:5000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
		header Cache-Control "no-store"
	}

	# Content-hashed build output: safe to pin for a year, because a
	# change to the bytes changes the filename.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br gzip
		}
	}

	# Stable (non-hashed) paths — long TTL, but not immutable.
	handle /fonts/* {
		header Cache-Control "public, max-age=2592000"
		header Access-Control-Allow-Origin "*"
		file_server {
			precompressed br gzip
		}
	}

	handle /question-media/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html names the current bundles, so it must revalidate every
	# time or users stay pinned to a deleted build after a deploy.
	handle {
		header Cache-Control "no-cache, must-revalidate"
		header X-Content-Type-Options "nosniff"
		header Referrer-Policy "strict-origin-when-cross-origin"
		header Strict-Transport-Security "max-age=31536000; includeSubDomains"

		try_files {path} /index.html
		file_server
	}
}
